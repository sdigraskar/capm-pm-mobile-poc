COLUMN TABLE asset_master_Material (
  SWERK NVARCHAR(4) NOT NULL,
  LGORT NVARCHAR(4) NOT NULL,
  MATNR NVARCHAR(18) NOT NULL,
  LANGU NVARCHAR(2) NOT NULL,
  MAKTX NVARCHAR(40),
  LGPBE NVARCHAR(18),
  MATKL NVARCHAR(9),
  LABST DECIMAL(15, 3),
  MEINS NVARCHAR(3),
  SALK3 DECIMAL(15, 3),
  WAERS NVARCHAR(5),
  KZKRI NVARCHAR(1),
  DISMM NVARCHAR(2),
  MINBE DECIMAL(15, 3),
  DISLS NVARCHAR(2),
  BSTMI DECIMAL(16, 3),
  BSTMA DECIMAL(16, 3),
  BSTFE DECIMAL(16, 3),
  MABST DECIMAL(16, 3),
  ZMANUFACTURER NVARCHAR(40),
  ZMANUF_REF NVARCHAR(40),
  PRIMARY KEY(SWERK, LGORT, MATNR, LANGU)
)