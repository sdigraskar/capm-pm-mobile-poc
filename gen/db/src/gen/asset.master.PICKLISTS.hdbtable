COLUMN TABLE asset_master_PICKLISTS (
  SWERK NVARCHAR(4) NOT NULL,
  PICKLIST_ID NVARCHAR(5000) NOT NULL,
  LANGU NVARCHAR(2) NOT NULL,
  EXT_CODE NVARCHAR(40) NOT NULL,
  PICKLIST_TYPE NVARCHAR(4),
  PICKLIST_NAME NVARCHAR(40),
  INT_CODE NVARCHAR(40),
  DESCRIPTION NVARCHAR(60),
  ID_PICKLIST_PARENT NVARCHAR(4),
  PARENT_CODE NVARCHAR(255),
  CUSTOMER_FIELD NVARCHAR(100),
  OPTION_ACTIVE NVARCHAR(1),
  PRIMARY KEY(SWERK, PICKLIST_ID, LANGU, EXT_CODE)
)