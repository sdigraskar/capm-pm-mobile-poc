COLUMN TABLE asset_master_INVENTORY (
  IBLNR NVARCHAR(10) NOT NULL,
  GJAHR NVARCHAR(4) NOT NULL,
  WERKS NVARCHAR(4),
  LGORT NVARCHAR(4),
  STATUS NVARCHAR(30),
  CREA_DATE TIMESTAMP,
  CREA_USER NVARCHAR(100),
  CREA_USER_TEXT NVARCHAR(100),
  MOD_USER NVARCHAR(100),
  MOD_USER_TEXT NVARCHAR(100),
  PRIMARY KEY(IBLNR, GJAHR)
)