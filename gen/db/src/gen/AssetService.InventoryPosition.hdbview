VIEW AssetService_InventoryPosition AS SELECT
  INVENTORY_POSITION_0.IBLNR,
  INVENTORY_POSITION_0.ZEILE,
  INVENTORY_POSITION_0.MATNR,
  INVENTORY_POSITION_0.MENGE,
  INVENTORY_POSITION_0.MEINS,
  INVENTORY_POSITION_0.ERFMG,
  INVENTORY_POSITION_0.ERFME,
  INVENTORY_POSITION_0.XNULL,
  INVENTORY_POSITION_0."COUNT"
FROM asset_master_INVENTORY_POSITION AS INVENTORY_POSITION_0