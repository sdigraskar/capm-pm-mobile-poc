COLUMN TABLE asset_master_Plants (
  PLANT NVARCHAR(100) NOT NULL,
  PLANT_NAME NVARCHAR(100),
  NOTIFICATION_MODEL NVARCHAR(100),
  RESERVATIONS NVARCHAR(100),
  SMWHAPPS NVARCHAR(100),
  TMWHAPPS NVARCHAR(100),
  TPMAPP NVARCHAR(1),
  PDIAS INTEGER,
  PDIASORDER INTEGER,
  WAREHOUSEQUANTITY NVARCHAR(1),
  OFFLINE NVARCHAR(1),
  MANUALDATE NVARCHAR(1),
  TPMYELLOWCARD NVARCHAR(1),
  BREAKDOWN NVARCHAR(1),
  PREVENTIVES NVARCHAR(1),
  PRIMARY KEY(PLANT)
)