VIEW AssetService_OrderNotification AS SELECT
  ORDER_NOTIFICATION_0.AUFNR,
  ORDER_NOTIFICATION_0.VORNR,
  ORDER_NOTIFICATION_0.ARBID,
  ORDER_NOTIFICATION_0.ARBID_DESC,
  ORDER_NOTIFICATION_0.START_DATE,
  ORDER_NOTIFICATION_0.END_DATE,
  ORDER_NOTIFICATION_0.WORK_SHIFT,
  ORDER_NOTIFICATION_0.NOTIF_TEXT,
  ORDER_NOTIFICATION_0.NOTIF_END,
  ORDER_NOTIFICATION_0.OP_DESCRIPTION
FROM asset_master_ORDER_NOTIFICATION AS ORDER_NOTIFICATION_0