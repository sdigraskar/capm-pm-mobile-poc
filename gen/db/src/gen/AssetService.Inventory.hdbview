VIEW AssetService_Inventory AS SELECT
  INVENTORY_0.IBLNR,
  INVENTORY_0.GJAHR,
  INVENTORY_0.WERKS,
  INVENTORY_0.LGORT,
  INVENTORY_0.STATUS,
  INVENTORY_0.CREA_DATE,
  INVENTORY_0.CREA_USER,
  INVENTORY_0.CREA_USER_TEXT,
  INVENTORY_0.MOD_USER,
  INVENTORY_0.MOD_USER_TEXT
FROM asset_master_INVENTORY AS INVENTORY_0