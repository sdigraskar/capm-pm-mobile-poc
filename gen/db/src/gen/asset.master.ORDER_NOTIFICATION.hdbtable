COLUMN TABLE asset_master_ORDER_NOTIFICATION (
  AUFNR NVARCHAR(100) NOT NULL,
  VORNR NVARCHAR(100) NOT NULL,
  ARBID NVARCHAR(100) NOT NULL,
  ARBID_DESC NVARCHAR(100),
  START_DATE TIMESTAMP,
  END_DATE TIMESTAMP,
  WORK_SHIFT NVARCHAR(100),
  NOTIF_TEXT NVARCHAR(40),
  NOTIF_END NVARCHAR(1),
  OP_DESCRIPTION NVARCHAR(150),
  PRIMARY KEY(AUFNR, VORNR, ARBID)
)