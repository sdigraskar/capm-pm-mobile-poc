VIEW AssetService_PicklistEquipment AS SELECT
  PICKLIST_EQUIPEMENT_0.SWERK,
  PICKLIST_EQUIPEMENT_0.EQUNR,
  PICKLIST_EQUIPEMENT_0.LANGU,
  PICKLIST_EQUIPEMENT_0.SHTXT,
  PICKLIST_EQUIPEMENT_0.TPLNR,
  PICKLIST_EQUIPEMENT_0.INGRP,
  PICKLIST_EQUIPEMENT_0.TIDNR,
  PICKLIST_EQUIPEMENT_0.TIDNRSELECT
FROM asset_master_PICKLIST_EQUIPEMENT AS PICKLIST_EQUIPEMENT_0