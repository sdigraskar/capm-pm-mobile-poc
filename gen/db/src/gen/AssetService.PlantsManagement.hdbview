VIEW AssetService_PlantsManagement AS SELECT
  PLANTS_MANAGEMENT_0.PLANT,
  PLANTS_MANAGEMENT_0.PLANT_NAME,
  PLANTS_MANAGEMENT_0.NOTIFICATION_MODEL,
  PLANTS_MANAGEMENT_0.RESERVATIONS,
  PLANTS_MANAGEMENT_0.SMWHAPPS,
  PLANTS_MANAGEMENT_0.TMWHAPPS,
  PLANTS_MANAGEMENT_0.MANUALDATE,
  PLANTS_MANAGEMENT_0.TPMYELLOWCARD,
  PLANTS_MANAGEMENT_0.TPMAPP,
  PLANTS_MANAGEMENT_0.PDIAS,
  PLANTS_MANAGEMENT_0.PDIASORDER,
  PLANTS_MANAGEMENT_0.WAREHOUSEQUANTITY
FROM asset_master_PLANTS_MANAGEMENT AS PLANTS_MANAGEMENT_0