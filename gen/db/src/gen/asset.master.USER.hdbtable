COLUMN TABLE asset_master_USER (
  UID NVARCHAR(5000) NOT NULL,
  USERNAME NVARCHAR(100),
  FIRSTNAME NVARCHAR(100),
  LASTNAME NVARCHAR(100),
  PASSWORD NVARCHAR(100),
  JOB_FUNCTION NVARCHAR(100),
  GROUP_FUNCTION NVARCHAR(100),
  MAIL NVARCHAR(100),
  TELEPHONE NVARCHAR(100),
  "LANGUAGE" NVARCHAR(100),
  GROUPS NVARCHAR(100),
  ARTICLE NVARCHAR(100),
  PLANT NVARCHAR(100),
  WORK_SHIFT NVARCHAR(100),
  LOG_DATE TIMESTAMP,
  PRIMARY KEY(UID)
)