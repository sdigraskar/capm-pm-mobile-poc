  LGORT NVARCHAR(4) NOT NULL,
  MATNR NVARCHAR(18) NOT NULL,
  LANGU NVARCHAR(2) NOT NULL,
  MAKTX NVARCHAR(40),
  LGPBE NVARCHAR(18),
  MATKL NVARCHAR(9),
  LABST NVARCHAR(5000),
  MEINS NVARCHAR(3),
  SALK3 NVARCHAR(5000),
  WAERS NVARCHAR(5),
  KZKRI NVARCHAR(1),
  DISMM NVARCHAR(2),
  MINBE NVARCHAR(5000),
  DISLS NVARCHAR(2),
  BSTMI NVARCHAR(5000),
  BSTMA NVARCHAR(5000),
  BSTFE NVARCHAR(5000),
