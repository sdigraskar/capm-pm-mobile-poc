VIEW AssetService_User AS SELECT
  USER_0.UID,
  USER_0.USERNAME,
  USER_0.FIRSTNAME,
  USER_0.LASTNAME,
  USER_0.PASSWORD,
  USER_0.JOB_FUNCTION,
  USER_0.GROUP_FUNCTION,
  USER_0.MAIL,
  USER_0.TELEPHONE,
  USER_0."LANGUAGE",
  USER_0.GROUPS,
  USER_0.ARTICLE,
  USER_0.PLANT,
  USER_0.WORK_SHIFT,
  USER_0.LOG_DATE
FROM asset_master_USER AS USER_0