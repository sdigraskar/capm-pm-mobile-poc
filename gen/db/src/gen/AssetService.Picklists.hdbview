VIEW AssetService_Picklists AS SELECT
  PICKLISTS_0.SWERK,
  PICKLISTS_0.PICKLIST_ID,
  PICKLISTS_0.LANGU,
  PICKLISTS_0.EXT_CODE,
  PICKLISTS_0.PICKLIST_TYPE,
  PICKLISTS_0.PICKLIST_NAME,
  PICKLISTS_0.INT_CODE,
  PICKLISTS_0.DESCRIPTION,
  PICKLISTS_0.ID_PICKLIST_PARENT,
  PICKLISTS_0.PARENT_CODE,
  PICKLISTS_0.CUSTOMER_FIELD,
  PICKLISTS_0.OPTION_ACTIVE
FROM asset_master_PICKLISTS AS PICKLISTS_0