COLUMN TABLE asset_master_User (
  UID INTEGER NOT NULL,
  USERNAME NVARCHAR(50),
  FIRSTNAME NVARCHAR(50),
  LASTNAME NVARCHAR(100),
  PASSWORD NVARCHAR(50),
  JOB_FUNCTION NVARCHAR(20),
  MAIL NVARCHAR(100),
  TELEPHONE NVARCHAR(50),
  "LANGUAGE" NVARCHAR(10),
  GROUPS NVARCHAR(50),
  ARTICLE NVARCHAR(50),
  PLANT NVARCHAR(10),
  WORK_SHIFT NVARCHAR(10),
  GROUP_FUNCTION NVARCHAR(50),
  LOG_DATE TIMESTAMP,
  PRIMARY KEY(UID)
)